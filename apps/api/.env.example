APP_ENV=development
# JSON list only. On Vercel include the public demo origin, e.g.
# ["https://auteur-education-demo.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI provider (server-side only; never expose to the frontend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: low | medium | high (only for reasoning-capable models)
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_SECONDS=240
BLUEPRINT_WEB_SEARCH=true
RESEARCH_SEARCH_CONTEXT_SIZE=medium

# Demo-only limits (DEC-007). Leave GENERATION_MAX_MODULES empty to build all modules.
GENERATION_MAX_MODULES=1
GENERATION_MAX_ATTEMPTS=3
MAX_FREE_TEXT_CHARS=4000

# Persistence (server-side only). Leave empty to keep the in-memory DemoStore.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe sandbox only. Never put these in the browser or in NEXT_PUBLIC_ variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Credit holds on course build stay off until the pre-generation journey is decided.
COMMERCIAL_GATE_ENABLED=false
PUBLIC_SITE_URL=http://localhost:3000

# Lesson narration (DEC-024). Secrets stay on this API. Never NEXT_PUBLIC_*.
TTS_ENABLED=true
TTS_PROVIDER=mock
TTS_ALLOW_MOCK=false
TTS_MODEL=eleven_multilingual_v2
TTS_VOICE_ID=mock-voice
TTS_OUTPUT_FORMAT=mp3_44100_128
TTS_MAX_INPUT=
TTS_MAX_ACTIVE_JOBS_PER_USER=1
TTS_LEASE_SECONDS=120
TTS_MONTHLY_UNIT_CAP=0
TTS_MAX_CHUNK_ATTEMPTS=3
TTS_SIGNED_URL_SECONDS=300
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
CRON_SECRET=
