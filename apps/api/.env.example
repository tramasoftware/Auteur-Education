APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# AI provider (server-side only; never expose to the frontend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: low | medium | high (only for reasoning-capable models)
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_SECONDS=240
BLUEPRINT_WEB_SEARCH=true
RESEARCH_SEARCH_CONTEXT_SIZE=medium

# Demo-only limits (DEC-007). Leave GENERATION_MAX_MODULES empty to build all modules.
GENERATION_MAX_MODULES=1
GENERATION_MAX_ATTEMPTS=3
MAX_FREE_TEXT_CHARS=4000

# Persistence (server-side only). Leave empty to keep the in-memory DemoStore.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=https://fzpisosynzijotcjbshj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_IoRCvg-bmoFgvoH00WcLOQ_XmbYM3__
# Seeded profile used when APP_ENV != production and no Authorization header.
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
